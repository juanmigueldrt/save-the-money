{
  "description": "ORC-146. Filtros de PostgREST de la lista de movimientos (búsqueda y cursor), compartidos por las pruebas de STMData, de Android y por supabase/tests/api/filtros_postgrest.py, que los manda al Supabase local del CI. `filter` es lo que va dentro de or=(…), escrito a mano a partir de la regla: en LIKE, \\ % _ llevan \\ delante y * pasa a _; entre comillas, \\ pasa a \\\\ y \" a \\\". `matches` son las claves de `movements` que debe devolver el servidor. `cursorOrder` es el orden de la lista (día y id de mayor a menor) y `cursor` lo que va dentro de or=(…) para pedir lo que va detrás de esa fila. Datos inventados.",
  "search": [
    {
      "name": "texto normal, que también vale como etiqueta",
      "input": "pan",
      "filter": "description.ilike.\"*pan*\",notes.ilike.\"*pan*\",payee.ilike.\"*pan*\",tags.cs.{pan}",
      "matches": [
        "A"
      ]
    },
    {
      "name": "% es un carácter, no un comodín",
      "input": "50%",
      "filter": "description.ilike.\"*50\\\\%*\",notes.ilike.\"*50\\\\%*\",payee.ilike.\"*50\\\\%*\"",
      "matches": [
        "B"
      ]
    },
    {
      "name": "_ es un carácter, no un comodín",
      "input": "a_b",
      "filter": "description.ilike.\"*a\\\\_b*\",notes.ilike.\"*a\\\\_b*\",payee.ilike.\"*a\\\\_b*\",tags.cs.{a_b}",
      "matches": [
        "D"
      ]
    },
    {
      "name": "barra invertida",
      "input": "C:\\temp",
      "filter": "description.ilike.\"*C:\\\\\\\\temp*\",notes.ilike.\"*C:\\\\\\\\temp*\",payee.ilike.\"*C:\\\\\\\\temp*\"",
      "matches": [
        "F"
      ]
    },
    {
      "name": "comillas dobles",
      "input": "di \"hola\"",
      "filter": "description.ilike.\"*di \\\"hola\\\"*\",notes.ilike.\"*di \\\"hola\\\"*\",payee.ilike.\"*di \\\"hola\\\"*\"",
      "matches": [
        "G"
      ]
    },
    {
      "name": "coma",
      "input": "uno, dos",
      "filter": "description.ilike.\"*uno, dos*\",notes.ilike.\"*uno, dos*\",payee.ilike.\"*uno, dos*\"",
      "matches": [
        "H"
      ]
    },
    {
      "name": "paréntesis, en la descripción y en las notas",
      "input": "(nota)",
      "filter": "description.ilike.\"*(nota)*\",notes.ilike.\"*(nota)*\",payee.ilike.\"*(nota)*\"",
      "matches": [
        "I",
        "J"
      ]
    },
    {
      "name": "puntos, en el beneficiario",
      "input": "S.A.",
      "filter": "description.ilike.\"*S.A.*\",notes.ilike.\"*S.A.*\",payee.ilike.\"*S.A.*\"",
      "matches": [
        "K"
      ]
    },
    {
      "name": "* cuenta como un carácter cualquiera",
      "input": "a*c",
      "filter": "description.ilike.\"*a_c*\",notes.ilike.\"*a_c*\",payee.ilike.\"*a_c*\"",
      "matches": [
        "L",
        "M"
      ]
    },
    {
      "name": "emoji y tilde",
      "input": "café 😀",
      "filter": "description.ilike.\"*café 😀*\",notes.ilike.\"*café 😀*\",payee.ilike.\"*café 😀*\"",
      "matches": [
        "N"
      ]
    },
    {
      "name": "importe con signo",
      "input": "-12,50",
      "filter": "description.ilike.\"*-12,50*\",notes.ilike.\"*-12,50*\",payee.ilike.\"*-12,50*\",amount_minor.eq.-1250",
      "matches": [
        "Q"
      ]
    },
    {
      "name": "etiqueta con #",
      "input": "#Viaje",
      "filter": "description.ilike.\"*#Viaje*\",notes.ilike.\"*#Viaje*\",payee.ilike.\"*#Viaje*\",tags.cs.{viaje}",
      "matches": [
        "R",
        "Q"
      ]
    },
    {
      "name": "texto que intenta cerrar el filtro",
      "input": "a),or(id.neq.0",
      "filter": "description.ilike.\"*a),or(id.neq.0*\",notes.ilike.\"*a),or(id.neq.0*\",payee.ilike.\"*a),or(id.neq.0*\"",
      "matches": []
    }
  ],
