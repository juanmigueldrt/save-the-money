// Ajustes comunes de la app. Los valores reales de Supabase van en
// Config/Secrets.xcconfig, que git ignora (copia Secrets.example.xcconfig).

// Por defecto apunta al Supabase local de `supabase start`.
SUPABASE_URL = http:/$()/127.0.0.1:54321
SUPABASE_ANON_KEY =

// Cambia el prefijo por uno tuyo en Secrets.xcconfig para firmar en tu iPhone.
STM_BUNDLE_ID = com.example.savethemoney
DEVELOPMENT_TEAM =

#include? "Secrets.xcconfig"
