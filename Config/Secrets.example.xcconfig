// Copia este archivo a Config/Secrets.xcconfig y rellénalo. Ese archivo NO se sube a git.
//
// La URL y la clave anon de Supabase están pensadas para ir dentro de la app
// (los datos los protege RLS). La clave service_role NUNCA va aquí ni en ningún
// archivo del repo.
//
// En xcconfig "//" empieza un comentario, por eso la URL se escribe con "/$()/".

SUPABASE_URL = https:/$()/TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY = pega-aqui-la-clave-anon

STM_BUNDLE_ID = com.tu-nombre.savethemoney
DEVELOPMENT_TEAM = TU_TEAM_ID
